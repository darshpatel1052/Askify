# Sample .env file for Askify (v2.0 Next-Gen)
# Copy this file to .env and fill in your values if running backend mode

# FastAPI Settings
DEBUG=True
PORT=8000

# Authentication Secret (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="askify-super-secret-jwt-key-change-in-production-12345"

# Storage Mode: 'local' (zero-config file storage, default) or 'supabase'
STORAGE_MODE=local
LOCAL_DB_DIR=./local_db
VECTOR_DB_PATH=./chromadb

# Optional: OpenAI API Key (For live GPT-4o RAG generation)
OPENAI_API_KEY=

# Optional: Supabase Credentials (Only needed if STORAGE_MODE=supabase)
SUPABASE_URL=
SUPABASE_KEY=
